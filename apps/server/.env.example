# Server Configuration
PORT=4000
NODE_ENV=development

# PostgreSQL Connection String (Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pollwave?schema=public

# Redis Connection String
REDIS_URL=redis://localhost:6379

# Secrets
JWT_SECRET=super-secret-jwt-key-change-in-production
SERVER_SECRET=super-secret-internal-server-key

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000

# Performance & Timing Tunables
FLUSH_INTERVAL_MS=3000
BROADCAST_INTERVAL_MS=200
PRESENTER_GRACE_PERIOD_MS=60000
