# PostgreSQL Connection String (Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pollwave?schema=public

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=super-secret-nextauth-key-change-in-production

# Shared JWT Secret (must match server JWT_SECRET for socket-token verification)
JWT_SECRET=super-secret-jwt-key-change-in-production

# Socket.io Backend Server URL (accessible by browser)
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Anthropic Claude API Key (optional - realistic intelligent fallbacks used if omitted)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
