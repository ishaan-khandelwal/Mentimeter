# PostgreSQL Connection String (Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pollwave?schema=public

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=super-secret-nextauth-key-change-in-production

# Shared JWT Secret (must match server JWT_SECRET for socket-token verification)
JWT_SECRET=super-secret-jwt-key-change-in-production

# Socket.io Backend Server URL (accessible by browser)
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Redis Connection String (optional — must match the socket server's REDIS_URL).
# Lets the REST /lobby fallback route read the live quiz state the socket
# server publishes, instead of getting stuck after the first question when a
# client's WebSocket can't connect. Safe to omit; the fallback just degrades.
REDIS_URL=redis://localhost:6379

# Gemini API Key (free tier — get one at https://aistudio.google.com/apikey).
# Used first for AI slide generation/summaries when present.
GEMINI_API_KEY=your-gemini-api-key-here

# Anthropic Claude API Key (optional fallback if Gemini key is not set)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
